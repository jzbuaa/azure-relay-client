<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>relay_client</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>relay</ToolCommandName>
    <PackageId>relay-client</PackageId>
    <Version>1.0.0</Version>
    <Description>Forward Azure Relay hybrid connections to local HTTP services.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Relay" Version="3.1.1" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="config.json.example" LogicalName="RelayClient.Config.Example" />
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
